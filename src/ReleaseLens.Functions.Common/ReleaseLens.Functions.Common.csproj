<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    ReleaseLens.Core only, among the solution's own projects. ReleaseLens.Llm would pull in the ONNX
    runtime, ReleaseLens.Embedding and ReleaseLens.Storage (Npgsql), which would bloat both Function
    packages and their cold start.
  -->
  <ItemGroup>
    <ProjectReference Include="..\ReleaseLens.Core\ReleaseLens.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

</Project>
