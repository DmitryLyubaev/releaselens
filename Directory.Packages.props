<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Data">
    <PackageVersion Include="Npgsql" Version="9.0.3" />
    <PackageVersion Include="Npgsql.DependencyInjection" Version="9.0.3" />
    <PackageVersion Include="Dapper" Version="2.1.79" />
    <PackageVersion Include="Pgvector" Version="0.3.0" />
    <PackageVersion Include="Pgvector.Dapper" Version="0.3.0" />
  </ItemGroup>
  <ItemGroup Label="Embedding">
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="1.0.2" />
  </ItemGroup>
  <ItemGroup Label="Hosting">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <!--
      Never below a package that needs it. Hosting 10.0.11 and Http 10.0.11 need this package at
      10.0.11, and Azure.Identity 1.21.0 needs it at 10.0.3 (through Azure.Core 1.53.0 and
      Microsoft.Extensions.Hosting.Abstractions 10.0.3). With transitive pinning on, a lower pin
      is a downgrade (NU1109) and restore fails, so it moves with Hosting and Http.
    -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="9.5.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <!--
      Transitive pin, through Microsoft.AspNetCore.OpenApi. Versions up to and including 2.7.4
      carry GHSA-v5pm-xwqc-g5wc (high), and 2.7.5 is the first patched release. AspNetCore.OpenApi
      10.0.11 needs 2.7.5 or later, and 10.0.12 needs 2.12.0 or later, so raising that package
      past 10.0.11 means raising this pin with it, or restore fails on NU1109.
    -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="7.2.0" />
  </ItemGroup>
  <ItemGroup Label="Identity">
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>
  <ItemGroup Label="Functions">
    <!-- The isolated worker model, the only one Flex Consumption runs on .NET 10. -->
    <PackageVersion Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.1.0" />
    <!-- The queue trigger, with the identity-based IngestQueue connection and host.json messageEncoding (5.x and later). -->
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Storage.Queues" Version="5.5.5" />
    <!-- The MCP tool trigger and its Streamable HTTP endpoint (/runtime/webhooks/mcp); latest stable 1.x. -->
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Mcp" Version="1.6.0" />
    <!-- Reads the artefact blob with the managed identity. -->
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.30.1" />
  </ItemGroup>
  <ItemGroup Label="Telemetry">
    <!--
      1.11.x is what Tasks 9/11/16 originally pinned, but OpenTelemetry.Api 1.11.1 and
      OpenTelemetry.Exporter.OpenTelemetryProtocol 1.11.1 both carry known moderate-severity
      advisories (GHSA-8785-wc3w-h8q6, GHSA-g94r-2vxg-569j, GHSA-4625-4j76-fww9), which NuGet
      audit turns into build errors under TreatWarningsAsErrors the moment a project actually
      references them (Task 19 is the first to do so). Bumped the whole set to the latest
      stable release, which carries none of those advisories.
    -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit.v3" Version="1.1.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.0.1" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.1.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.5.0" />
    <!--
      Transitive pin, not a direct dependency. Testcontainers.PostgreSql 4.1.0 pulls in
      SSH.NET for its remote-Docker-over-SSH support, which this project does not use.
      Versions up to and including 2025.1.0 carry GHSA-q939-rpr3-3284 (high, CVSS 7.1):
      ScpClient.Download() does not validate server-supplied filenames during a recursive
      download, so a malicious server can traverse out of the target directory. Nothing
      here calls that method, but NuGet audit flags the package regardless and
      TreatWarningsAsErrors turns the warning into a failed restore. 2026.0.0 is the first
      patched release. Remove this pin once Testcontainers ships a version that references
      2026.0.0 or later itself.
    -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>
</Project>
