!infra/terraform/*.tfvars.example
infra/terraform/.terraform.lock.hcl

# Python eval service
eval/.venv/
eval/__pycache__/
eval/**/__pycache__/
eval/.pytest_cache/

# Test output
TestResults/
coverage/
