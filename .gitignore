# Build output
[Bb]in/
[Oo]bj/
artifacts/
*.user
*.suo
.vs/
.idea/

# Secrets — never commit
.env
.env.*
!.env.example
appsettings.Development.json
appsettings.Local.json
*.pfx

# ONNX model weights (~130 MB) — fetched by scripts/fetch-model.*
models/

# Terraform — both stacks (infra/bootstrap, infra/terraform)
infra/**/.terraform/
infra/**/*.tfstate
infra/**/*.tfstate.*
# A saved plan carries resolved values — for bootstrap, the storage account key;
# for the app stack, the generated Postgres password and the connection string built
# from it. Either is as sensitive as state.
infra/**/tfplan
infra/**/*.tfplan
infra/**/*.tfvars
infra/**/*.tfvars.json
!infra/**/*.tfvars.example
# Override files are local-only: a backend override points init at a stand-in backend
# (or none) instead of the committed one. No override has any business being versioned.
infra/**/override.tf
infra/**/override.tf.json
infra/**/*_override.tf
infra/**/*_override.tf.json
# Crash logs, from Terraform's standard ignore list.
infra/**/crash*.log
# .terraform.lock.hcl is deliberately NOT ignored. HashiCorp's guidance is to commit it:
# it pins exact provider versions and their checksums, so a clone gets byte-identical
# providers rather than whatever the ~> constraint resolves to that week, and the
# checksums are the supply-chain control that constraint alone does not give.

# Python eval service
eval/.venv/
eval/__pycache__/
eval/**/__pycache__/
eval/.pytest_cache/

# Infra test harness
tests/infra/__pycache__/
tests/infra/.pytest_cache/
scripts/__pycache__/

# Test output
TestResults/
coverage/

# Eval sweep output. Reports are evidence of a run, not source; the README quotes
# the headline numbers instead. Committing them would also commit answer text.
eval/reports/
