# Build output
[Bb]in/
[Oo]bj/
artifacts/
*.user
*.suo
.vs/
.idea/

# Secrets — never commit
.env
.env.*
!.env.example
appsettings.Development.json
appsettings.Local.json
*.pfx

# ONNX model weights (~130 MB) — fetched by scripts/fetch-model.*
models/

# Terraform
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/*.tfvars
!infra/terraform/*.tfvars.example
# .terraform.lock.hcl is deliberately NOT ignored. HashiCorp's guidance is to commit it:
# it pins exact provider versions and their checksums, so a clone gets byte-identical
# providers rather than whatever the ~> constraint resolves to that week, and the
# checksums are the supply-chain control that constraint alone does not give.

# Python eval service
eval/.venv/
eval/__pycache__/
eval/**/__pycache__/
eval/.pytest_cache/

# Test output
TestResults/
coverage/

# Eval sweep output. Reports are evidence of a run, not source; the README quotes
# the headline numbers instead. Committing them would also commit answer text.
eval/reports/
